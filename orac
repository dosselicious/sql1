#!/usr/bin/env bash

script_path="$(readlink -f "$BASH_SOURCE")"
script_dir="$(dirname "$script_path")"

# .env has the password ORACLE_PWD
source "$script_dir/.env"

sqlcl(){
    podman compose -f "$script_dir/compose.yaml" --profile tools run --rm  \
    "${MOUNT_ARGS[@]}" \
    sqlcl -S system/"$ORACLE_PWD"@//oracle-free:1521/freepdb1 "$@"
}
 
file="$1"
MOUNT_ARGS=()
 
if [[ -f "$file" ]]; then
    sql_abs="$(readlink -f "$file")"
    sql_dir="$(dirname "$sql_abs")"
    sql_name="$(basename "$sql_abs")"
    MOUNT_ARGS=(-v "$sql_dir:/work:ro,Z" -w /work)

    sqlcl "@/work/$sql_name"
else
	MOUNT_ARGS=(-v "$PWD:/work:ro,Z" -w /work)	
    sqlcl
fi
